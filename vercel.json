{
  "version": 2,
  "_comment": "trigger redeploy",
  "builds": [{ "src": "server.js", "use": "@vercel/node" }],
  "routes": [{ "src": "/(.*)", "dest": "server.js" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOW-FROM https://coolmattgames.cool"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://coolmattgames.cool"
        }
      ]
    }
  ]
}
